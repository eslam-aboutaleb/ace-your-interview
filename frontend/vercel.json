{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://study-app-backend-cn5k.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets|pwa-|maskable-|apple-touch|manifest|registerSW|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
