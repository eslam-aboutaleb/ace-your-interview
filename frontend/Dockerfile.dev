FROM node:20-slim

WORKDIR /app

# Install deps first (cached layer)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source (overridden by volume mounts in dev)
COPY . .

EXPOSE 5174

# Vite dev server with HMR — listen on all interfaces so Docker port mapping works
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5174"]
