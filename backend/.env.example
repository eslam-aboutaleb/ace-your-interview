# ─── LLM API Keys (set the ones you want to use) ───────────
# Free tier: Groq gives 30 req/min for llama-3.3-70b
GROQ_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google AI Studio (free Gemini API)
GEMINI_API_KEY=

# GitHub Models
GITHUB_TOKEN=

# ─── App settings ──────────────────────────────────────────
STUDY_DEFAULT_PROVIDER=groq
STUDY_DEFAULT_MODEL=llama-3.3-70b-versatile
STUDY_DEFAULT_TEMPERATURE=0.7
STUDY_ENABLE_MOCK_INTERVIEW_V1=true

# ─── OAuth login (GitHub + Google) ───────────────────────
# Frontend origin used to build OAuth redirect_uri values.
# For local Vite dev this is usually http://localhost:5174
STUDY_FRONTEND_URL=http://localhost:5174

# Required for signing login sessions (must be 32+ chars)
STUDY_AUTH_SECRET_KEY=

# OAuth app credentials
STUDY_GITHUB_CLIENT_ID=
STUDY_GITHUB_CLIENT_SECRET=
STUDY_GOOGLE_CLIENT_ID=
STUDY_GOOGLE_CLIENT_SECRET=

# Allow-lists for login access (comma-separated)
STUDY_ALLOWED_GITHUB_USERS=
STUDY_ALLOWED_GOOGLE_EMAILS=

# Docs path (relative to backend root when running locally)
STUDY_DOCS_PATH=../docs

# ─── Backend state files ───────────────────────────────────
# Keep these outside the repo (e.g. ./data/) so a local run never drops
# Fernet-encrypted credentials, OAuth tokens or the login allowlist into the
# working tree. Docker Compose overrides all of these to /app/data.
STUDY_LEARNING_DB_PATH=./data/study_hub_learning.db
STUDY_USER_SETTINGS_FILE=./data/user_llm_settings.json
STUDY_LLM_SERVICE_USERS_FILE=./data/llm_service_users.json
STUDY_LLM_ASSIGNMENTS_FILE=./data/llm_assignments.json
STUDY_ALLOWED_USERS_FILE=./data/allowed_users.json

# CORS — add your Vercel domain once deployed
STUDY_CORS_ORIGINS=http://localhost:5174,http://localhost:5173,https://your-app.vercel.app
